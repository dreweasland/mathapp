// Cloudflare Worker: the built PWA as static files, plus the cloud sync API under /api/.
// Static files are served without running any code; only /api/* reaches the Worker script.
// Child progress reaches the server only when a grown-up turns on sync, and then encrypted.
// Cloudflare Workers Builds runs `npm run build`, then `npx wrangler deploy` from the repo root.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "mathapp",
  "main": "./apps/worker/src/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    // The app has one page; any other path gets it too, as the service worker does offline.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // The Worker makes its own tables on first use, so there's no migration step.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mathapp-sync",
      "database_id": "f3038ed8-3ff0-41b6-b67c-dee8218bc4c9",
    },
  ],
  // Hourly, so each family's recap goes out at Sunday 6pm in their own time zone.
  "triggers": { "crons": ["0 * * * *"] },
  // Email needs two secrets, RESEND_API_KEY and MAIL_FROM (see README). Without them the
  // app works as before and the sync screen says sync isn't set up.
  "workers_dev": true,
  // Each preview URL is its own origin with its own empty storage, so they'd only confuse.
  "preview_urls": false,
  "observability": { "enabled": false },
}
