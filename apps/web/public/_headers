# Read by Cloudflare when serving apps/web/dist; it is not served as a file.
# Everything else, including index.html and sw.js, keeps Cloudflare's default of
# revalidating on every request, so a new version reaches the phone on the next open.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=()

# File names under /assets/ include a content hash, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
