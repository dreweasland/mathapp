{
  "name": "mathapp",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @mathapp/web",
    "build": "npm run build -w @mathapp/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --project engine --coverage",
    "e2e": "npm run e2e -w @mathapp/web",
    "demo": "tsx scripts/demo-quest.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p packages/engine --noEmit && tsc -p packages/content --noEmit && tsc -p apps/web --noEmit && tsc -p scripts --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "serve": "npm run build && wrangler dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "wrangler": "4.153.0"
  }
}
